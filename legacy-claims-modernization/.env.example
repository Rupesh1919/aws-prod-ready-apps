# Application Configuration
APP_NAME=Claims API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ENVIRONMENT=local

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=claims_db
DATABASE_USER=claims_user
# DATABASE_PASSWORD - Set in .env or environment, never commit
DATABASE_SSL_MODE=prefer
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_RELOAD=false

# Authentication Configuration (JWT/OIDC)
# For local development, these can be test values
# For AWS deployment, use production identity provider
AUTH_ENABLED=true
JWT_ISSUER=https://your-issuer.example.com
JWT_AUDIENCE=claims-api
JWT_ALGORITHMS=RS256
JWKS_URL=https://your-issuer.example.com/.well-known/jwks.json
JWKS_CACHE_TTL=3600

# For local testing without real auth (NEVER use in production)
# AUTH_ENABLED=false

# OpenAPI Documentation
OPENAPI_ENABLED=true
OPENAPI_URL=/api/openapi.json
DOCS_URL=/api/docs

# Health Check Configuration
HEALTH_DB_TIMEOUT=5

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Request Configuration
MAX_DESCRIPTION_LENGTH=2000
CORRELATION_ID_HEADER=X-Correlation-ID
